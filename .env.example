# Copy to .env and uncomment only what you need to change. .env is ignored by git.
# Every setting has a default, so FlowGuard runs without a .env file.
#
# Leave a line commented unless you mean to change it: in Docker Compose, the
# container's own defaults (its Ollama address, its database paths on a volume)
# are correct, and a value set here replaces them.

# Where the Ollama API is.
#   Running locally:                 http://localhost:11434 (the default)
#   Docker Compose, host's Ollama:   http://host.docker.internal:11434 (its default)
#   Docker Compose, --profile ollama: http://ollama:11434
# FLOWGUARD_OLLAMA_URL=http://ollama:11434

# The model Ollama runs. Pull it first: ollama pull gemma4:12b
# FLOWGUARD_MODEL=gemma4:12b

# A Qdrant server for the document index. Unset, the index is kept in memory and
# rebuilt at every start. Docker Compose points this at its own Qdrant.
# FLOWGUARD_QDRANT_URL=http://localhost:6333

# Where audit records and paused investigations are kept, when running locally.
# FLOWGUARD_AUDIT_DB=flowguard-audit.db
# FLOWGUARD_CHECKPOINT_DB=flowguard-checkpoints.db
